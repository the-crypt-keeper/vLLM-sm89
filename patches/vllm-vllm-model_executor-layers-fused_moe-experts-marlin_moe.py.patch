+# ---------------------------------------------------------------------------
+# Bug #4 instrumentation: order sensitivity in the Marlin MoE path.
+#
+# DeepSeek's reference MoE (inference/model.py, DeepseekV4 `MoE.forward`) has no
+# bucketing at all -- it does `y[idx] += expert(x[idx], ...)` over the rows
+# routed to each expert, so the result provably cannot depend on the order the
+# rows are visited in.  vLLM's Marlin path buckets rows into `block_size_m`
+# blocks via moe_align_block_size(), and a controlled A/B of two FIXED canonical
+# orderings (ascending vs descending token id within each expert run, see
+# VLLM_DSV4_DETERMINISTIC_MOE in moe_align_block_size.py) showed 76/77 prompt
+# logprobs differing, median 0.092 / max 1.62 nats.  Each order is individually
+# reproducible, so this is not a race -- the permutation itself is changing the
+# arithmetic.  That should be impossible, hence: instrument.
+#
+# ANSWER (measured 2026-08-02, TP8 sm89, VLLM_DSV4_MARLIN_ORDER_CHECK=3):
+#   Not a memory-safety bug.  Marlin schedules its tiles as "DP + two-tile
+#   stream-K" (marlin_template.h, `part1_mn_iters` / `part2_mn_tiles`, see
+#   vllm-project/vllm#24722).  `slice_count` -- how many threadblocks split the
+#   k-reduction for a tile, and therefore how the fp32 partial sums are GROUPED
+#   before the bf16 store -- is derived from `slice_col_par`, the global tile
+#   index, which is `moe_block_index * n_tiles + n_tile`.  So the accumulation
+#   grouping is a function of WHICH BLOCK a row lands in.  Two orderings that
+#   move a row between blocks of the same expert hand it a different, equally
+#   valid summation grouping, and it rounds differently.
+#
+#   The evidence, over 172 calls per rank at M in {16, 32, 78, 1024}:
+#     - asc-vs-asc control: 0 differing rows, every call, both GEMMs.  No race.
+#     - asc-vs-desc: differing rows are ALWAYS a subset of the rows that changed
+#       block.  `diff_not_moved == 0` in every single call.  A row that only
+#       changed lane within its block never changed value.
+#     - every difference is <= 1 bf16 ULP (max 7.8e-03 on values of that scale).
+#     - M=16 has one block per expert, so nothing moves and nothing differs.
+#
+#   And the amplification is real, not suspicious: VLLM_DSV4_MOE_ULP_JITTER=6
+#   (flip the low mantissa bit of every 6th expert-output row, for reasons
+#   unrelated to ordering) moves the 77 prompt logprobs by median 0.0935 /
+#   max 2.11 nats -- statistically indistinguishable from what reordering does
+#   (median 0.0920 / max 1.62).  43 layers plus the indexer's discrete top-512
+#   selection turn one ULP into tenths of a nat.
+#
+#   Consequence: the ordering CANNOT be made inert without changing marlin's
+#   schedule.  VLLM_DSV4_DETERMINISTIC_MOE is therefore the fix, not a
+#   workaround -- moe_align_block_size's atomicAdd rank leaks into the numerics
+#   whenever an expert holds more tokens than one block, and pinning the order
+#   is the only way to close that.  Keep the `=1` vs `=2` A/B as a regression
+#   gate: it must keep showing differences confined to moved rows and bounded
+#   by one ULP.
+#
+# VLLM_DSV4_MARLIN_TRACE=<path>  -- append per-call stage fingerprints as JSONL.
+#   Fingerprints are taken at every stage boundary inside _fused_marlin_moe so
+#   the first stage whose output differs between two orderings localizes the
+#   defect: gemm1 -> activation -> gemm2 -> moe_sum.  All of these are indexed
+#   by flat (token, topk) pair id, NOT by slot position, so every one of them
+#   must be bit-identical across orderings.
+# VLLM_DSV4_MARLIN_TRACE_MAX=<n>  -- stop after n calls (default 64).
+# VLLM_DSV4_MARLIN_POISON=<v>  -- prefill the intermediate caches with this
+#   value (e.g. "nan") instead of leaving torch.empty() garbage in them.  The
+#   caches are aliased (intermediate_cache1 and intermediate_cache3 are both
+#   views of intermediate_cache13) and never zeroed unless expert_map is set,
+#   so any row the kernels fail to write is read back as whatever the previous
+#   call left there.  If poisoning changes the output, some row is being
+#   consumed that was never written -- the same defect class as bugs #1 and #2.
+# ---------------------------------------------------------------------------
+_MARLIN_TRACE = os.environ.get("VLLM_DSV4_MARLIN_TRACE", "")
+_MARLIN_TRACE_MAX = int(os.environ.get("VLLM_DSV4_MARLIN_TRACE_MAX", "64"))
+_MARLIN_POISON = os.environ.get("VLLM_DSV4_MARLIN_POISON", "")
+# VLLM_DSV4_MARLIN_ORDER_CHECK=1 -- run each GEMM a second time with the rows
+#   of every expert run reversed, and diff.  Both orderings are legal outputs
+#   of moe_align_block_size(), so any difference is the bug.  Both destination
+#   buffers are seeded identically first (zeros, or the poison value) so an
+#   uninitialized-read cannot masquerade as an ordering effect.
+_MARLIN_ORDER_CHECK = os.environ.get("VLLM_DSV4_MARLIN_ORDER_CHECK", "0")
+# VLLM_DSV4_MOE_ULP_JITTER=<n> -- after GEMM1, flip the lowest mantissa bit of
+#   every n-th row of intermediate_cache1.  That is exactly the perturbation
+#   the order-check measured (<=1 ULP, on a minority of rows), applied
+#   deterministically and for a reason unrelated to ordering.  Comparing the
+#   engine's output with and without it calibrates how far a 1-ULP expert-output
+#   perturbation travels through 43 layers -- i.e. whether the ordering effect
+#   is sufficient to explain the observed end-to-end logprob divergence.
+_MOE_ULP_JITTER = int(os.environ.get("VLLM_DSV4_MOE_ULP_JITTER", "0"))
+_MARLIN_CALLS = 0
+
