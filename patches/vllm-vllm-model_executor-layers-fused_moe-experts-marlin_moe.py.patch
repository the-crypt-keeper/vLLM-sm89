+def _marlin_fp(t: torch.Tensor | None) -> dict | None:
+    """Order-insensitive value fingerprint of a tensor (float64 accumulation)."""
+    if t is None:
+        return None
+    f = t.detach().reshape(-1)
+    if f.dtype in (torch.int32, torch.int64, torch.int16, torch.uint8):
+        f = f.to(torch.float64)
+        return {
+            "shape": list(t.shape),
+            "sum": float(f.sum()),
+            "min": float(f.min()) if f.numel() else 0.0,
+            "max": float(f.max()) if f.numel() else 0.0,
+        }
+    f = f.to(torch.float64)
+    finite = torch.isfinite(f)
+    g = f[finite]
+    return {
+        "shape": list(t.shape),
+        "sum": float(g.sum()) if g.numel() else 0.0,
+        "abssum": float(g.abs().sum()) if g.numel() else 0.0,
+        "absmax": float(g.abs().max()) if g.numel() else 0.0,
+        "n_nonfinite": int((~finite).sum()),
+    }
+
+
+def _marlin_order_variants(
+    sorted_ids: torch.Tensor,
+    expert_ids: torch.Tensor,
+    block_size: int,
+    numel: int,
+    control: bool = False,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor] | None:
+    """Two canonical orderings of `sorted_ids` that must be numerically equal.
+
+    Both keep every token in the same expert RUN (the contiguous span of blocks
+    carrying one expert id) -- only the position of a token inside its run
+    changes, ascending token id vs descending.  moe_align_block_size() itself
+    picks an arbitrary one of these via an atomicAdd rank, so the kernel must
+    treat all of them identically or the engine is nondeterministic.
+
+    Returns (ascending, descending, run_id_per_slot) or None if the geometry
+    is not the expected block-padded one.
+    """
+    n = sorted_ids.numel()
+    n_blocks = expert_ids.numel()
+    if n == 0 or n_blocks * block_size < n:
+        return None
+    eids = expert_ids.to(torch.int64)
+    boundary = torch.ones_like(eids)
+    boundary[1:] = (eids[1:] != eids[:-1]).to(eids.dtype)
+    run_id = (torch.cumsum(boundary, 0) - 1).repeat_interleave(block_size)[:n]
+    ids = sorted_ids.to(torch.int64)
+    stride = numel + 1
+    asc = sorted_ids[torch.argsort(run_id * stride + ids, stable=True)]
+    rev = torch.where(ids < numel, numel - 1 - ids, ids)
+    desc = sorted_ids[torch.argsort(run_id * stride + rev, stable=True)]
+    if control:
+        # Control: compare the ascending order against ITSELF.  Any difference
+        # here is a race inside the kernel, not an ordering effect.
+        desc = asc.clone()
+
+    # Which rows changed BLOCK (not merely lane)?  A block is `block_size`
+    # consecutive slots; the k-split schedule is keyed on block index, so a row
+    # that moves between blocks of the same expert can legitimately pick up a
+    # different fp32 accumulation grouping, while a row that only changes lane
+    # within its block cannot.  This separates "non-associative reduction" from
+    # "reads something it should not".
+    slot_block = (
+        torch.arange(n, device=sorted_ids.device, dtype=torch.int64) // block_size
+    )
+    blk_a = torch.full((numel,), -1, device=sorted_ids.device, dtype=torch.int64)
+    blk_d = torch.full((numel,), -1, device=sorted_ids.device, dtype=torch.int64)
+    ia, id_ = asc.to(torch.int64), desc.to(torch.int64)
+    va, vd = ia < numel, id_ < numel
+    blk_a[ia[va]] = slot_block[va]
+    blk_d[id_[vd]] = slot_block[vd]
+    moved = blk_a != blk_d
+    return asc, desc, moved
+
+
+def _marlin_rowdiff(
+    a: torch.Tensor, b: torch.Tensor, moved: torch.Tensor | None = None
+) -> dict:
+    """Row-level difference between two (rows, cols) results.
+
+    `moved` marks rows that changed BLOCK between the two orderings.  If every
+    differing row is a moved row, the effect is non-associative fp32 reduction
+    across a different k-split grouping -- unpleasant but not memory unsafety.
+    A differing row that did NOT move is a real defect.
+    """
+    d = (a.to(torch.float64) - b.to(torch.float64)).abs()
+    nan_only = torch.isnan(a) ^ torch.isnan(b)
+    row_bad = (d > 0).any(dim=1) | nan_only.any(dim=1)
+    idx = row_bad.nonzero(as_tuple=True)[0]
+    finite = d[torch.isfinite(d)]
+    out = {
+        "rows": int(a.size(0)),
+        "rows_diff": int(row_bad.sum()),
+        "max_abs": float(finite.max()) if finite.numel() else 0.0,
+        "first_rows": idx[:16].tolist(),
+    }
+    if moved is not None and moved.numel() == a.size(0):
+        out["rows_moved"] = int(moved.sum())
+        out["diff_and_moved"] = int((row_bad & moved).sum())
+        out["diff_not_moved"] = int((row_bad & ~moved).sum())
+        stuck = (row_bad & ~moved).nonzero(as_tuple=True)[0]
+        out["stuck_rows"] = stuck[:16].tolist()
+    return out
+
+
+def _marlin_poison_value() -> float:
+    if not _MARLIN_POISON:
+        return 0.0
+    return float("nan") if _MARLIN_POISON.lower() == "nan" else float(_MARLIN_POISON)
+
+
+def _marlin_poison_(t: torch.Tensor) -> torch.Tensor:
+    if not _MARLIN_POISON:
+        return t
+    t.fill_(_marlin_poison_value())
+    return t
+
+
+def _marlin_seed_(t: torch.Tensor) -> torch.Tensor:
+    """Put a known, identical value in a GEMM destination before both runs."""
+    t.fill_(_marlin_poison_value())
+    return t
 
 
